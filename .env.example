# Required — shared secret between this agent and your Eight.ly OS instance
EIGHTLY_AGENT_SECRET=your-shared-secret-here

# Optional — set these to register with Eight.ly OS
EIGHTLY_SERVER_URL=https://your-eos-server:8080
EIGHTLY_ENROLL_TOKEN=your-enrollment-token

# Optional — host folders apps may bind-mount, comma-separated. Empty (the default)
# allows none. Mount each one into the agent at the same path, read-only, in
# docker-compose.yml.
# EIGHTLY_ALLOWED_BIND_ROOTS=/opt/appdata

# Optional
LOG_LEVEL=info

# Optional — the GID that owns /var/run/docker.sock on this host, when it is not 999:
#   stat -c %g /var/run/docker.sock
# DOCKER_GID=999
