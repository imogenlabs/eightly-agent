[Unit]
Description=Eight.ly Agent
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=eightly-agent
SupplementaryGroups=docker
ExecStart=/usr/bin/eightly-agent
Restart=always
RestartSec=5
Environment=AGENT_PORT=9001
Environment=LOG_LEVEL=info
Environment=DATA_PATH=/var/lib/eightly-agent
Environment=EIGHTLY_STATE_PATH=/var/lib/eightly-agent/eightly-agent.json
# Secret, server URL and enrollment token. Root-owned, mode 0600: systemd
# reads it before dropping to the agent user, and unlike Environment= in a
# drop-in its values do not show in `systemctl show` or a world-readable file.
# Values here override the Environment= lines above.
EnvironmentFile=/etc/eightly-agent/agent.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/eightly-agent
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# Requires systemd 247+ (Ubuntu 22.04+, Debian 12+, RHEL 9+)
ProtectProc=invisible
ProcSubset=pid
# MemoryDenyWriteExecute=true is intentionally omitted — the Go runtime
# requires writable+executable memory for goroutine stacks and the GC.

[Install]
WantedBy=multi-user.target
